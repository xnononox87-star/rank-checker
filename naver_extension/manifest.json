{
  "manifest_version": 3,
  "name": "HGG 네이버 순위 확인",
  "version": "1.0.0",
  "description": "HGG 순위 확인 프로그램과 연결해 네이버 가격비교 1페이지 순위를 확인합니다.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://search.shopping.naver.com/*", "http://127.0.0.1:8765/*"],
  "action": {"default_title": "HGG 네이버 순위 확인"},
  "background": {"service_worker": "background.js"}
}
